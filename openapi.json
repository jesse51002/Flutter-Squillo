{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAPI Squillo",
    "description": "FastAPI application with LLM service integration",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/import": {
      "post": {
        "summary": "Import recipe from any supported platform",
        "description": "Automatically detects platform (TikTok, YouTube, Instagram, or recipe website) and extracts recipe",
        "operationId": "import_recipe_v1_import_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/import/poll": {
      "post": {
        "summary": "Poll recipe import status",
        "description": "Check the status of one or more recipe imports by recipe IDs",
        "operationId": "poll_recipe_status_v1_import_poll_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PollingRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PollingResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/database/create-user": {
      "post": {
        "tags": [
          "database"
        ],
        "summary": "Create a new user",
        "description": "Creates a new user in the database",
        "operationId": "create_user_v1_database_create_user_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserCreateResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/database/users/{user_id}": {
      "get": {
        "tags": [
          "database"
        ],
        "summary": "Get user by ID",
        "description": "Retrieves a user's information by their ID",
        "operationId": "get_user_v1_database_users__user_id__get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/database/users/{user_id}/recipes": {
      "get": {
        "tags": [
          "database"
        ],
        "summary": "Get all recipes for user",
        "description": "Retrieves all completed and loading recipes belonging to a user",
        "operationId": "get_user_recipes_v1_database_users__user_id__recipes_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRecipesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/database/recipes/{recipe_id}": {
      "get": {
        "tags": [
          "database"
        ],
        "summary": "Get recipe by ID",
        "description": "Retrieves a specific recipe's full details by its ID",
        "operationId": "get_recipe_v1_database_recipes__recipe_id__get",
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Recipe Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoredRecipe"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/database/update-checked": {
      "post": {
        "tags": [
          "database"
        ],
        "summary": "Update ingredient checked status",
        "description": "Updates the checked status of an ingredient in a recipe. User must own the recipe to update it.",
        "operationId": "update_ingredient_checked_v1_database_update_checked_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateIngredientCheckedRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateIngredientCheckedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/educational-engine/recommend": {
      "post": {
        "tags": [
          "educational-engine"
        ],
        "summary": "Get technique recommendation for recipe step",
        "description": "Returns a recommended technique for a user based on their recipe step and learning history. Prioritizes unwatched techniques.",
        "operationId": "get_technique_recommendation_v1_educational_engine_recommend_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TechniqueRecommendationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TechniqueRecommendationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/educational-engine/mark-watched": {
      "post": {
        "tags": [
          "educational-engine"
        ],
        "summary": "Mark technique as watched",
        "description": "Records a watch session for a technique video, including watch percentage and timestamp.",
        "operationId": "mark_technique_watched_v1_educational_engine_mark_watched_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarkTechniqueWatchedRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarkTechniqueWatchedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/educational-engine/learned_techniques/{user_id}": {
      "get": {
        "tags": [
          "educational-engine"
        ],
        "summary": "Get learned techniques for a user",
        "description": "Get list of watched techniques ids for a user",
        "operationId": "learned_techniques_v1_educational_engine_learned_techniques__user_id__get",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TechniquesWatchedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/techniques/batch": {
      "post": {
        "tags": [
          "techniques"
        ],
        "summary": "Get multiple techniques by IDs",
        "description": "Returns a list of simplified techniques for the provided technique IDs. All IDs must be valid or the request will fail.",
        "operationId": "get_techniques_batch_v1_techniques_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchTechniquesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchTechniquesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Root",
        "description": "Root endpoint for health check.\n\nReturns:\n    dict: Basic application information",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "description": "Health check endpoint.\n\nReturns:\n    dict: Health status",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BatchTechniquesRequest": {
        "properties": {
          "technique_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Technique Ids",
            "description": "List of technique IDs to retrieve"
          }
        },
        "type": "object",
        "required": [
          "technique_ids"
        ],
        "title": "BatchTechniquesRequest",
        "description": "Request schema for batch technique retrieval."
      },
      "BatchTechniquesResponse": {
        "properties": {
          "techniques": {
            "items": {
              "$ref": "#/components/schemas/SimplifiedTechnique"
            },
            "type": "array",
            "title": "Techniques",
            "description": "List of simplified techniques"
          }
        },
        "type": "object",
        "required": [
          "techniques"
        ],
        "title": "BatchTechniquesResponse",
        "description": "Response schema for batch technique retrieval."
      },
      "ExtractionRecipeStep": {
        "properties": {
          "step_number": {
            "type": "string",
            "title": "Step Number",
            "description": "The sequential number of this step (supports decimals like 1.1, 1.2 for sub-steps)"
          },
          "instruction": {
            "type": "string",
            "title": "Instruction",
            "description": "The instruction text for this step"
          },
          "techniques": {
            "items": {
              "$ref": "#/components/schemas/ExtractionTechniqueInfo"
            },
            "type": "array",
            "title": "Techniques",
            "description": "List of cooking techniques used in this step with relevance and importance ratings"
          },
          "estimated_time": {
            "type": "number",
            "title": "Estimated Time",
            "description": "The estimated amount of time the step will take in minutes (decimals allowed)"
          },
          "is_active_step": {
            "type": "boolean",
            "title": "Is Active Step",
            "description": "Whether it is an active step (doing) or a passive step (waiting)"
          }
        },
        "type": "object",
        "required": [
          "step_number",
          "instruction",
          "estimated_time",
          "is_active_step"
        ],
        "title": "ExtractionRecipeStep",
        "description": "A single step in a recipe with associated cooking techniques."
      },
      "ExtractionTechniqueInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "ID of the chosen technique"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Name of technique chosen"
          },
          "importance": {
            "$ref": "#/components/schemas/TechniqueImportance",
            "description": "Technique Importance"
          },
          "difficulty": {
            "$ref": "#/components/schemas/TechniqueDifficulty",
            "description": "Techinque difficulty (leave empty in llm call)",
            "default": 2
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "importance"
        ],
        "title": "ExtractionTechniqueInfo"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImportRequest": {
        "properties": {
          "url": {
            "type": "string",
            "title": "Url",
            "description": "URL from any supported platform (TikTok, YouTube, Instagram, or recipe website)"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id",
            "description": "User ID for saving the recipe (if provided, recipe will be saved)"
          },
          "mock": {
            "type": "boolean",
            "title": "Mock",
            "description": "If True, uses mock data instead of real API calls",
            "default": false
          },
          "polling": {
            "type": "boolean",
            "title": "Polling",
            "description": "If True, return recipe_id immediately for polling instead of waiting for completion",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "ImportRequest",
        "description": "Request model for recipe import (used by all platforms)."
      },
      "ImportResponse": {
        "properties": {
          "recipe": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RecipeDisplayData"
              },
              {
                "type": "null"
              }
            ],
            "description": "Extracted recipe display data"
          },
          "no_recipe_found": {
            "type": "boolean",
            "title": "No Recipe Found",
            "description": "Whether or not a recipe was found in the video",
            "default": false
          },
          "recipe_id": {
            "type": "string",
            "title": "Recipe Id",
            "description": "Recipe ID for the imported recipe"
          }
        },
        "type": "object",
        "required": [
          "recipe_id"
        ],
        "title": "ImportResponse",
        "description": "Response model for recipe import (used by all platforms)."
      },
      "LoadingRecipe": {
        "properties": {
          "recipe_id": {
            "type": "string",
            "title": "Recipe Id",
            "description": "Unique identifier for the recipe"
          },
          "original_link": {
            "type": "string",
            "title": "Original Link",
            "description": "Original URL from which the recipe is being imported"
          },
          "time_started": {
            "type": "string",
            "format": "date-time",
            "title": "Time Started",
            "description": "Timestamp when the import started"
          },
          "status": {
            "$ref": "#/components/schemas/LoadingStatus",
            "description": "Current status of the import",
            "default": "processing"
          }
        },
        "type": "object",
        "required": [
          "recipe_id",
          "original_link"
        ],
        "title": "LoadingRecipe",
        "description": "Schema for tracking recipes currently being imported."
      },
      "LoadingStatus": {
        "type": "string",
        "enum": [
          "loading",
          "processing",
          "extracting_techniques",
          "completed",
          "error"
        ],
        "title": "LoadingStatus",
        "description": "Status values for recipes being imported and polled."
      },
      "MarkTechniqueWatchedRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "Unique identifier for the user"
          },
          "technique_id": {
            "type": "string",
            "title": "Technique Id",
            "description": "Unique identifier for the technique"
          },
          "watched_percentage": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Watched Percentage",
            "description": "Percentage of the video watched (0-100)"
          },
          "skipped": {
            "type": "boolean",
            "title": "Skipped",
            "description": "Whether the technique video was skipped",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "technique_id",
          "watched_percentage"
        ],
        "title": "MarkTechniqueWatchedRequest",
        "description": "Request schema for marking a technique as watched."
      },
      "MarkTechniqueWatchedResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "Whether the operation succeeded"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Success or error message"
          }
        },
        "type": "object",
        "required": [
          "success",
          "message"
        ],
        "title": "MarkTechniqueWatchedResponse",
        "description": "Response schema for marking technique as watched."
      },
      "PollingRequest": {
        "properties": {
          "recipe_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Recipe Ids",
            "description": "List of recipe IDs to check status for"
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "User ID who owns the recipes"
          }
        },
        "type": "object",
        "required": [
          "recipe_ids",
          "user_id"
        ],
        "title": "PollingRequest",
        "description": "Request model for polling recipe import status."
      },
      "PollingResponse": {
        "properties": {
          "statuses": {
            "additionalProperties": {
              "$ref": "#/components/schemas/RecipeStatus"
            },
            "type": "object",
            "title": "Statuses",
            "description": "Dictionary mapping recipe_id to its status"
          }
        },
        "type": "object",
        "required": [
          "statuses"
        ],
        "title": "PollingResponse",
        "description": "Response model for polling recipe import status."
      },
      "RecipeDifficulty": {
        "type": "integer",
        "enum": [
          1,
          2,
          3
        ],
        "title": "RecipeDifficulty"
      },
      "RecipeDisplayData": {
        "properties": {
          "recipe_id": {
            "type": "string",
            "title": "Recipe Id",
            "description": "Unique identifier for the recipe"
          },
          "recipe_name": {
            "type": "string",
            "title": "Recipe Name",
            "description": "Name of the recipe"
          },
          "thumbnail_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thumbnail Url",
            "description": "URL to the recipe thumbnail image"
          },
          "difficulty": {
            "$ref": "#/components/schemas/RecipeDifficulty",
            "description": "Overall recipe difficulty based on the most difficult technique used"
          },
          "technique_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Technique Ids",
            "description": "List of technique IDs used in this recipe"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Recipe creation time"
          }
        },
        "type": "object",
        "required": [
          "recipe_id",
          "recipe_name",
          "difficulty",
          "created_at"
        ],
        "title": "RecipeDisplayData",
        "description": "Lightweight recipe schema for displaying recipe summaries in lists.\n\nContains only the essential information needed to display a recipe card\nor list item, without the full recipe details."
      },
      "RecipeStatus": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/LoadingStatus",
            "description": "Current status of the recipe"
          },
          "recipe": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RecipeDisplayData"
              },
              {
                "type": "null"
              }
            ],
            "description": "Recipe display data (only present when status is 'completed')"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message",
            "description": "Error message if status is 'error'"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "RecipeStatus",
        "description": "Status of a single recipe in polling response."
      },
      "SimplifiedTechnique": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Technique ID"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Technique name"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "Technique description"
          },
          "video_url": {
            "type": "string",
            "title": "Video Url",
            "description": "Technique video URL"
          },
          "image": {
            "type": "string",
            "title": "Image",
            "description": "Base technique image"
          },
          "badge_image": {
            "anyOf": [
              {
                "type": "string"
              },
